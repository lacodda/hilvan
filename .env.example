# Copy to .env for local development. The real .env is never committed.

# SQLite file holding everything the tutor remembers: the learner model,
# schedules, generated material and the audio cache. Optional; this is the
# default. `mode=rwc` creates the file on first start, and the server
# creates the directory.
HILVAN_DATABASE_URL=sqlite://data/hilvan.db?mode=rwc

# Address the HTTP server binds to. Optional; defaults to 0.0.0.0:8086.
HILVAN_ADDR=127.0.0.1:8086

# Directory holding the built SPA. Optional; defaults to ./web/dist, which
# is what `pnpm build` produces. In development Vite serves the SPA itself
# on :5173 and proxies /api here, so the default can stay unbuilt.
# HILVAN_WEB_DIR=./web/dist

# Log filter (tracing-subscriber EnvFilter syntax). Optional.
RUST_LOG=hilvan=debug,tower_http=info

# The Piper service that speaks the learner's own language. Optional; unset
# leaves that language silent. The compose files run Piper as `piper` and set
# this for you; for `cargo run`, start one with
#   docker run --rm -p 5000:5000 ghcr.io/lacodda/hilvan-piper:latest
# HILVAN_PIPER_URL=http://127.0.0.1:5000

# ElevenLabs key the language being learnt is spoken with (Profile -> API Keys,
# with the Text to Speech permission). Optional; unset, Piper speaks it too.
# HILVAN_ELEVENLABS_KEY=

# Argon2 hash of the password the learner signs in with, produced by
# `hilvan hash`. Optional; unset leaves the stand open to anyone who can reach
# it, which is fine on a developer's machine and a choice on a home network.
# The server warns at startup when it is unset.
#
# Single-quoted: a PHC string is full of $, and both a shell and compose
# expand $VAR in an unquoted value.
# HILVAN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
